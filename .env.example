# Postgres in production, e.g. postgres://user:pass@host:5432/esimdb
# Leave empty to use the local SQLite file at ./data/esimdb.db
DATABASE_URI=
PAYLOAD_SECRET=change-me-to-a-long-random-string
SITE_URL=http://localhost:3000

# Scraper: one or more proxies, comma separated. http://user:pass@host:port
SCRAPER_PROXIES=
# Cron expression for the worker (UTC). Default: every day at 03:00
SCRAPER_CRON=0 3 * * *
# Fetch Trustpilot reviews and TrustScore (true/false)
TRUSTPILOT_ENABLED=true
# Politeness delay between requests to the same host (ms), request timeout (ms), retries
SCRAPER_HOST_DELAY_MS=1500
SCRAPER_TIMEOUT_MS=30000
SCRAPER_RETRIES=3
# Cap the number of countries per-country adapters visit (0 = all countries in the DB)
SCRAPER_MAX_COUNTRIES=0
# Official Trustpilot API key (preferred over page scraping when set)
TRUSTPILOT_API_KEY=
# Airalo Partner API credentials (preferred over the website JSON when set)
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=

# --- docker compose (server) ---
DOMAIN=example.com
POSTGRES_PASSWORD=change-me
SITE_NAME=eSIM Compare
# Run the scraper once when the worker starts
SCRAPER_RUN_ON_START=true
